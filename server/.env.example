DEEPSEEK_API_KEY=replace-on-server
CAMPUS_ACCESS_TOKEN=replace-with-a-long-random-server-signing-secret
AI_MODEL=deepseek-flash
ALLOWED_ORIGINS=https://kemou2333.github.io
AI_THINKING_MODE=none
AI_DAILY_BUDGET_RMB=3
DAILY_REQUEST_LIMIT=30
IP_DAILY_REQUEST_LIMIT=10
ACCOUNT_DAILY_REQUEST_LIMIT=10
PORT=8787
BIND_HOST=127.0.0.1
USAGE_STATE_FILE=/var/lib/campus-inbox/usage.json
SYNC_STATE_FILE=/var/lib/campus-inbox/sync.sqlite
AUTH_STATE_FILE=/var/lib/campus-inbox/auth.sqlite

# Self-hosted image verification at the third high-frequency request; no external account.
CAPTCHA_MODE=image

# Disabled until the owner configures an existing sending mailbox. See docs/EMAIL-LOGIN.md.
MAIL_LOGIN_ENABLED=false
SMTP_AUTH_MODE=password
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=123456789@qq.com
SMTP_FROM=123456789@qq.com
SMTP_PASSWORD=replace-with-qq-mail-authorization-code-on-server

# Outlook personal-account alternative: oauth2, smtp-mail.outlook.com, 587, secure=false.
# Keep every secret outside the repository; the rotated refresh token is saved privately.
# SMTP_OAUTH_CLIENT_ID=replace-on-server
# SMTP_OAUTH_CLIENT_SECRET=replace-on-server
# SMTP_OAUTH_REFRESH_TOKEN=replace-on-server
# SMTP_OAUTH_STATE_FILE=/var/lib/campus-inbox/smtp-oauth.json
