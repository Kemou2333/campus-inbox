[Unit]
Description=Private Campus Inbox online backup
After=campus-inbox.service
[Service]
Type=oneshot
User=campus-inbox
Group=campus-inbox
ExecStart=/usr/bin/python3 /opt/campus-inbox/current/server/backup-state.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/campus-inbox/backups
MemoryMax=128M
TimeoutStartSec=120
