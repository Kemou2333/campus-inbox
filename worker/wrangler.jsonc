{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campus-inbox-api",
  "main": "index.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "AI_BASE_URL": "",
    "AI_MODEL": "",
    "AI_JSON_MODE": "true",
    "ALLOWED_ORIGINS": ""
  },
  "ratelimits": [{
    "name": "AI_RATE_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 5, "period": 60 }
  }]
}
