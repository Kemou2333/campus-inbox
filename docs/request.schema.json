{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Kemou2333/campus-inbox/main/docs/request.schema.json",
  "title": "校园Inbox整理请求",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "notice"
      ],
      "additionalProperties": false,
      "properties": {
        "notice": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    }
  ],
  "$comment": "所有原文合计上限4,000由服务端额外验证，字数按JavaScript字符串长度计；附件和本地字段不接受。"
}
